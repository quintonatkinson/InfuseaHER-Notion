# Copy this file to .env.local for local development and fill in the values.
# On Vercel, add the same names under Project Settings -> Environment Variables.
# Never commit a real .env file.

# Notion internal integration secret (starts with "ntn_"). Server-side only.
NOTION_TOKEN=

# IDs from the brief. You only need to change these if the databases are moved or recreated.
NOTION_TASKS_DATA_SOURCE_ID=3c30941e-7a9b-81d2-897a-000ba9805db7
NOTION_PROJECTS_DATA_SOURCE_ID=3c30941e-7a9b-81ee-a593-000be5c15413
NOTION_ROOT_PAGE_ID=21c0941e7a9b80278586dd7bfa4e7723
# The "Softwares & Logins" page. The app refuses to read or write it.
NOTION_BLOCKED_PAGE_IDS=3c20941e7a9b8150958bf472ca653c7d

# How long (seconds) to reuse Notion data before fetching again.
CACHE_TTL_SECONDS=60

# --- Used from step 2 onwards ---
# Shared passphrase for logging in, and a long random string for signing the session cookie.
APP_PASSPHRASE=
SESSION_SECRET=

# --- Used from step 3 onwards ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
