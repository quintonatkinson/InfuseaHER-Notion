# Only the first two are required. On Vercel, add them under
# Project -> Settings -> Environment Variables. Locally, copy this file to .env.local.
# Never commit a real .env file.

# Notion internal integration secret (starts with "ntn_"). Server-side only.
NOTION_TOKEN=

# The passphrase you and Chelsey type to log in.
APP_PASSPHRASE=

# --- Optional ---
# Signs the login cookie. If unset, a key is derived from NOTION_TOKEN.
# Set it if you ever want to log everyone out (change it to a new value).
SESSION_SECRET=

# Workspace IDs. Defaults are built in (see src/lib/config.ts); only set these
# if the databases move. NOTION_BLOCKED_PAGE_IDS adds pages the app must never
# touch, on top of "Softwares & Logins", which is always blocked.
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_ROOT_PAGE_ID=
NOTION_BLOCKED_PAGE_IDS=

# How long (seconds) to reuse Notion data before fetching again.
CACHE_TTL_SECONDS=60

# --- Used from step 3 (chat) onwards ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
